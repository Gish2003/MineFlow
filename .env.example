# MineFlow AI - environment variables (names only; no real secrets here).
# Copy to .env and fill in what you need. jac run does not auto-load .env;
# core/config.jac loads it on first use without overriding already-exported vars.

# --- Demo mode -------------------------------------------------------------
# When true, the login page lists seeded demo personas (clearly labelled as
# demo-only, not production auth) and the admin "reset demo" action is enabled.
MINEFLOW_DEMO_MODE=true
MINEFLOW_DEMO_PASSWORD=MineFlow#Demo2026

# First administrator bootstrap (only usable while no admin account exists;
# ignored once one does). Leave blank to disable the bootstrap-admin flow.
MINEFLOW_BOOTSTRAP_ADMIN_CODE=

# --- Agentic planning --------------------------------------------------------
# auto  = use the LLM if the matching provider key below is present, else a
#         labelled deterministic fallback runs the same tools.
# llm   = force the LLM path (fails loudly if no key is configured).
# fallback = always use the deterministic planner (never calls an LLM).
MINEFLOW_AGENT_MODE=auto
MINEFLOW_LLM_MODEL=anthropic/claude-sonnet-5

# Provider credential matching MINEFLOW_LLM_MODEL's prefix. Only one is
# needed. Never commit a real key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Business tunables -------------------------------------------------------
MINEFLOW_CURRENCY=LKR
MINEFLOW_HAULAGE_RATE_PER_TKM=48.0
MINEFLOW_DRIVER_BASE_PAY=4500.0
MINEFLOW_DRIVER_RATE_PER_KM=95.0
MINEFLOW_MAX_LOAD_T=40.0
MINEFLOW_TZ_OFFSET_HOURS=5.5

# Connectivity thresholds (seconds since the last location ping).
MINEFLOW_LIVE_SECONDS=45
MINEFLOW_WEAK_SECONDS=180

# Evidence upload cap (bytes).
MINEFLOW_MAX_UPLOAD_BYTES=3000000

# --- Build (WSL/drvfs workaround) --------------------------------------------
# bun install hangs when the build dir is on a Windows drive mounted in WSL
# (/mnt/<drive>). Point it at a Linux-native path there.
MINEFLOW_BUILD_DIR=/home/YOUR_USER/.mineflow-build
